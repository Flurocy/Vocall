{
  "name": "vocall",
  "version": "1.6.1",
  "description": "Vocall — 被动弹窗式雅思背词桌面工具",
  "author": "",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win nsis"
  },
  "keywords": [],
  "type": "commonjs",
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.9",
    "gsap": "^3.15.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@40.10.6": true
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^40.10.6",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.20",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.vocall.app",
    "productName": "Vocall",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "data",
        "to": "data"
      },
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Vocall-${version}-setup.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Flurocy",
        "repo": "Vocall"
      }
    ]
  }
}
